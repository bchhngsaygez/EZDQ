{
	"name": "ezdq",
	"productName": "EZDQ",
	"version": "2.0.0",
	"description": "EZDQ (Easy Discord Quest) - Tự động làm nhiệm vụ Discord chạy trên Web (Local, VPS, Docker, Cloud Host)",
	"author": "bchhngsaygez",
	"license": "GPL-3.0-only",
	"type": "commonjs",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev:server": "tsx watch server/index.ts",
		"dev:client": "vite",
		"dev": "npm run dev:server",
		"build:client": "vite build",
		"build:server": "tsc -p tsconfig.server.json",
		"build": "npm run build:client && npm run build:server",
		"start": "node dist/server/index.js",
		"clean": "node -e \"const fs = require('fs'); ['dist', '.cache'].forEach(p => fs.rmSync(p, {recursive: true, force: true}))\""
	},
	"dependencies": {
		"@discordjs/core": "2.4.0",
		"@discordjs/rest": "2.6.0",
		"@discordjs/ws": "2.0.4",
		"canvas-confetti": "^1.9.4",
		"clsx": "^2.1.1",
		"cors": "^2.8.5",
		"discord-api-types": "^0.38.42",
		"express": "^4.21.2",
		"lucide-react": "^0.475.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"undici": "^6.24.1",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/canvas-confetti": "^1.9.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.0",
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/ws": "^8.5.14",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.5.2",
		"tailwindcss": "^3.4.17",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"vite": "^6.1.0"
	}
}
